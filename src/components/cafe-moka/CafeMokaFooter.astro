---
import data from '../../data/restaurants/cafe_moka.json';
const { footer, branding } = data;
---

<footer class="bg-[#362618] text-[#FEFAE7] pt-24 pb-16 px-6 md:px-12 lg:px-16 overflow-hidden border-t border-[#FEFAE7]/10">
  <div class="max-w-7xl mx-auto space-y-20">
    
    <!-- Meta Details Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-sm text-[#D6C6B8]">
      <div class="space-y-3">
        <span class="text-[11px] uppercase font-mono tracking-widest text-[#FFFFA8] block">location</span>
        <p class="font-medium text-[#FEFAE7] text-base leading-relaxed">
          {footer.address}
        </p>
        <span class="text-xs text-[#D6C6B8] block">telok ayer / chinatown district</span>
      </div>

      <div class="space-y-3">
        <span class="text-[11px] uppercase font-mono tracking-widest text-[#FFFFA8] block">hours of service</span>
        <p class="font-medium text-[#FEFAE7] text-base leading-relaxed">
          {footer.hours}
        </p>
        <span class="text-xs text-[#D6C6B8] block">walk-ins warmly welcomed anytime</span>
      </div>

      <div class="space-y-4">
        <span class="text-[11px] uppercase font-mono tracking-widest text-[#FFFFA8] block">direct desk</span>
        <a
          href={`https://wa.me/${footer.whatsappNumber}?text=Hi%20Moka,%20I'd%20like%20to%20inquire%20about%20a%20table%20or%20pre-order.`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-[#FFFFA8] text-[#362618] font-display font-black text-xs uppercase tracking-wider hover:bg-[#FEFAE7] transition-colors"
        >
          <span>{footer.reachLabel}</span>
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12c0 1.82.49 3.53 1.34 5L2 22l5.18-1.31C8.61 21.49 10.26 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm0 18c-1.57 0-3.05-.44-4.32-1.21l-.31-.19-3.2.81.85-3.08-.21-.33C4.31 14.77 3.8 13.43 3.8 12c0-4.52 3.68-8.2 8.2-8.2s8.2 3.68 8.2 8.2-3.68 8.2-8.2 8.2z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Giant 18vw Lowercase Kinetic Display Wordmark -->
    <div class="pt-8 select-none text-center">
      <h2 class="font-display font-black text-[18vw] leading-[0.8] tracking-tighter text-[var(--moka-froth)]/10 lowercase hover:text-[var(--moka-froth)]/20 transition-colors duration-700">
        {footer.giantWordmark}
      </h2>
    </div>

    <!-- Bottom Copyright & Back to Top -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-white/10 text-xs text-[#D6C6B8]">
      <p>{footer.copyright}</p>
      <div class="flex items-center gap-6">
        <a href="#about" class="hover:text-[#FFFFA8] transition-colors">story</a>
        <a href="#menu" class="hover:text-[#FFFFA8] transition-colors">menu</a>
        <a href="#roast" class="hover:text-[#FFFFA8] transition-colors">3d bean</a>
        <a href="#merch" class="hover:text-[#FFFFA8] transition-colors">goods</a>
      </div>
    </div>

  </div>
</footer>
