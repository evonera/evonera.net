---
import data from '../../data/restaurants/cafe_moka.json';
const { hero } = data;
---

<section class="relative min-h-screen pt-28 pb-16 px-6 md:px-12 lg:px-16 flex flex-col justify-between overflow-hidden">
  <!-- Top Meta / Eyebrow -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-12 border-b border-[var(--moka-border)]">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--moka-dark-roast)] text-[var(--moka-butter)] text-xs font-medium tracking-wide">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--moka-butter)]"></span>
      {hero.badge}
    </div>
    <div class="text-xs tracking-widest uppercase font-semibold text-[var(--moka-froth)] opacity-80">
      {hero.eyebrow}
    </div>
  </div>

  <!-- Giant Kinetic Lowercase Display -->
  <div class="py-12 md:py-16 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
    <div class="lg:col-span-8 space-y-6">
      <h1 class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-[5.2vw] leading-[1.04] font-extrabold tracking-tighter lowercase text-[var(--moka-froth)]">
        {hero.titleMain}
        <span class="font-script text-4xl sm:text-6xl md:text-7xl text-[var(--moka-butter)] font-normal block mt-3 lowercase transform -rotate-1">
          {hero.scriptAccent}
        </span>
      </h1>
    </div>

    <!-- Editorial Hero Portrait Card -->
    <div class="lg:col-span-4 flex justify-center lg:justify-end">
      <div class="relative w-full max-w-[340px] aspect-[4/5] rounded-[32px] overflow-hidden shadow-2xl border-4 border-[rgba(254,250,231,0.25)] group">
        <img
          src={hero.heroImage}
          alt="cafe moka atmosphere"
          class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[var(--moka-dark-roast)]/60 via-transparent to-transparent"></div>
        <div class="absolute bottom-5 left-5 right-5 flex items-center justify-between text-xs text-[var(--moka-froth)]">
          <span class="font-display font-bold tracking-tight lowercase">singapore central</span>
          <span class="font-script text-lg text-[var(--moka-butter)]">fresh daily</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Scroll Hint -->
  <div class="pt-8 border-t border-[var(--moka-border)] flex items-center justify-between text-xs text-[var(--moka-froth)]">
    <a href="#about" aria-label="Scroll down to story" class="flex items-center gap-3 min-h-[44px] group">
      <div class="w-9 h-9 rounded-full border border-[var(--moka-froth)] flex items-center justify-center group-hover:bg-[var(--moka-butter)] group-hover:text-[var(--moka-dark-roast)] transition-colors animate-bounce">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12 16.5l-6-6h12l-6 6z" />
        </svg>
      </div>
      <span class="tracking-widest uppercase font-medium text-[11px] opacity-90 group-hover:text-[var(--moka-butter)] transition-colors">{hero.scrollHint}</span>
    </a>
    <div class="hidden sm:block font-script text-2xl text-[var(--moka-butter)]">
      table for one, table for all
    </div>
  </div>
</section>
