---
import data from '../../data/restaurants/cafe_moka.json';
const { merchShowcase } = data;
---

<section id="merch" class="relative bg-[#8A6E5A] text-[#FEFAE7] py-24 md:py-32 px-6 md:px-12 lg:px-16 overflow-hidden">
  <div class="max-w-7xl mx-auto space-y-16">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-6 pb-8 border-b border-[#FEFAE7]/20">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#362618] text-[#FFFFA8] text-xs uppercase tracking-widest font-semibold">
          {merchShowcase.badge}
        </div>
        <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-black lowercase tracking-tight">
          {merchShowcase.title}
        </h2>
        <p class="font-script text-2xl text-[#FFFFA8]">
          {merchShowcase.scriptAccent}
        </p>
      </div>
      <p class="text-sm md:text-base text-[#FEFAE7]/80 max-w-md">
        {merchShowcase.description}
      </p>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {merchShowcase.items.map((item) => (
        <div class="rounded-[32px] bg-[#362618] p-8 flex flex-col justify-between space-y-8 border border-white/10 hover:border-[#FFFFA8] transition-all duration-500 group shadow-xl">
          <div class="space-y-6">
            <div class="aspect-square rounded-2xl overflow-hidden bg-black/30 relative">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
              />
              <div class="absolute top-4 right-4 px-3 py-1 rounded-full bg-[#FFFFA8] text-[#362618] font-display font-black text-sm">
                {item.price}
              </div>
            </div>

            <div class="space-y-2">
              <span class="text-[11px] uppercase tracking-wider font-mono text-[#D6C6B8]">
                {item.material}
              </span>
              <h3 class="font-display text-xl sm:text-2xl font-bold lowercase text-[#FEFAE7] leading-snug">
                {item.title}
              </h3>
            </div>

            <ul class="space-y-2 text-xs text-[#D6C6B8] border-t border-white/10 pt-4">
              {item.features.map((feat) => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#FFFFA8]"></span>
                  {feat}
                </li>
              ))}
            </ul>
          </div>

          <a
            href={`https://wa.me/${data.footer.whatsappNumber}?text=Hi%20Moka,%20I'd%20like%20to%20order%20the%20${encodeURIComponent(item.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3.5 rounded-full bg-[#FEFAE7] text-[#362618] hover:bg-[#FFFFA8] font-display text-xs font-black uppercase tracking-wider text-center transition-colors shadow"
          >
            order via whatsapp
          </a>
        </div>
      ))}
    </div>

  </div>
</section>
