---
import data from '../../data/restaurants/cafe_moka.json';
const { splitStickyMenu } = data;
---

<section id="menu" class="relative bg-[#FEFAE7] text-[#362618] py-24 px-6 md:px-12 lg:px-16 overflow-visible">
  <div class="max-w-7xl mx-auto">
    <!-- Top Bar Header -->
    <div class="flex items-center justify-between pb-8 mb-12 border-b border-[#362618]/15">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#362618] text-[#FFFFA8] text-xs uppercase tracking-widest font-semibold">
        {splitStickyMenu.badge}
      </div>
      <span class="font-script text-2xl text-[#8A6E5A]">served fresh all day</span>
    </div>

    <!-- The 2-Column Split Sticky Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- LEFT HALF: STICKY VIEWPORT CONTAINER -->
      <div class="lg:col-span-5 lg:sticky lg:top-24 self-start">
        <div class="rounded-[36px] bg-[#362618] text-[#FEFAE7] p-8 md:p-10 shadow-xl space-y-8 overflow-hidden relative border border-[#362618]/30">
          
          <div class="space-y-4">
            <h2 class="font-display text-5xl md:text-6xl font-black lowercase tracking-tighter text-[#FFFFA8]">
              {splitStickyMenu.title}
            </h2>
            <p class="font-body text-sm md:text-base leading-relaxed text-[#D6C6B8]">
              {splitStickyMenu.stickyTeaser}
            </p>
          </div>

          <!-- Sticky Editorial Visual -->
          <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden shadow-inner bg-black/40">
            <img
              src={splitStickyMenu.stickyImage}
              alt="cafe moka fresh creations"
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
            <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs text-[#FFFFA8]">
              <span class="font-mono text-[11px] uppercase tracking-wider">in-house preparation</span>
              <span class="font-script text-base">crafted with care</span>
            </div>
          </div>

          <!-- Category Quick Anchors with Dynamic Active State -->
          <div class="space-y-2 pt-2 border-t border-[#FEFAE7]/15">
            <div class="text-[11px] uppercase tracking-widest font-mono text-[#D6C6B8]/70">quick browse</div>
            <div class="flex flex-wrap gap-2">
              {splitStickyMenu.categories.map((cat, idx) => (
                <a
                  href={`#category-${cat.id}`}
                  class="category-nav-pill px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 bg-[#FEFAE7]/10 text-[#FEFAE7] hover:bg-[#FFFFA8] hover:text-[#362618]"
                  data-cat-target={`category-${cat.id}`}
                >
                  {cat.name}
                </a>
              ))}
            </div>
          </div>

        </div>
      </div>

      <!-- RIGHT HALF: SCROLLING DETAILS COLUMN -->
      <div class="lg:col-span-7 space-y-20">
        {splitStickyMenu.categories.map((cat) => (
          <div id={`category-${cat.id}`} class="category-block space-y-8 scroll-mt-28">
            <!-- Category Header -->
            <div class="space-y-2 pb-4 border-b-2 border-[#362618]">
              <div class="flex items-center justify-between">
                <h3 class="font-display text-3xl md:text-4xl font-extrabold lowercase tracking-tight text-[#362618]">
                  {cat.name}
                </h3>
                <span class="text-xs font-mono uppercase tracking-widest text-[#8A6E5A]">
                  {cat.items.length} items
                </span>
              </div>
              <p class="text-xs md:text-sm text-[#8A6E5A] font-medium lowercase">
                {cat.subtitle}
              </p>
            </div>

            <!-- Items List -->
            <div class="space-y-4">
              {cat.items.map((item) => (
                <div class="p-5 md:p-6 rounded-2xl bg-white border border-[#362618]/10 hover:border-[#362618]/40 hover:shadow-md transition-all duration-300 flex flex-col sm:flex-row gap-5 items-start sm:items-center justify-between group">
                  
                  {item.image && (
                    <div class="w-16 h-16 md:w-20 md:h-20 rounded-xl overflow-hidden flex-shrink-0 bg-[#FEFAE7] border border-[#362618]/10">
                      <img
                        src={item.image}
                        alt={item.name}
                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
                        loading="lazy"
                      />
                    </div>
                  )}

                  <div class="flex-grow space-y-2">
                    <div class="flex items-baseline justify-between gap-4">
                      <h4 class="font-display text-lg md:text-xl font-bold text-[#362618] lowercase tracking-tight">
                        {item.name}
                      </h4>
                      <span class="font-display text-base md:text-lg font-extrabold text-[#362618] px-3 py-1 rounded-full bg-[#FEFAE7] border border-[#362618]/15">
                        {item.price}
                      </span>
                    </div>

                    <p class="text-xs md:text-sm text-[#8A6E5A] leading-relaxed">
                      {item.desc}
                    </p>

                    <div class="flex flex-wrap gap-1.5 pt-1">
                      {item.tags.map((tag) => (
                        <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-[#FEFAE7] text-[#362618]/70 border border-[#362618]/10">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>

                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<!-- Intersection Observer Script for Split Sticky Navigation -->
<script>
  const categoryPills = document.querySelectorAll('.category-nav-pill');
  const categoryBlocks = document.querySelectorAll('.category-block');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        categoryPills.forEach(pill => {
          if (pill.getAttribute('data-cat-target') === id) {
            pill.classList.remove('bg-[#FEFAE7]/10', 'text-[#FEFAE7]');
            pill.classList.add('bg-[#FFFFA8]', 'text-[#362618]');
          } else {
            pill.classList.add('bg-[#FEFAE7]/10', 'text-[#FEFAE7]');
            pill.classList.remove('bg-[#FFFFA8]', 'text-[#362618]');
          }
        });
      }
    });
  }, {
    rootMargin: '-20% 0px -70% 0px'
  });

  categoryBlocks.forEach(block => observer.observe(block));
</script>
