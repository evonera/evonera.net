---
import data from '../../data/restaurants/cafe_moka.json';
const { aboutDeck } = data;
---

<section id="about" class="relative bg-[var(--moka-dark-roast)] text-[var(--moka-froth)] py-24 md:py-32 px-6 md:px-12 lg:px-16 overflow-hidden">
  <!-- Section Header -->
  <div class="max-w-4xl mx-auto mb-20 text-center space-y-4">
    <div class="inline-block px-3.5 py-1 rounded-full bg-[rgba(254,250,231,0.1)] border border-[rgba(254,250,231,0.2)] text-[var(--moka-butter)] text-xs uppercase tracking-widest font-semibold">
      {aboutDeck.badge}
    </div>
    <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight lowercase leading-tight">
      {aboutDeck.title}
    </h2>
  </div>

  <!-- Cards Grid / Deck Container -->
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
    {aboutDeck.cards.map((card, idx) => (
      <article class="flex flex-col justify-between rounded-[32px] p-8 bg-[rgba(254,250,231,0.06)] border border-[rgba(254,250,231,0.12)] hover:border-[var(--moka-butter)] transition-all duration-500 group">
        <div class="space-y-6">
          <div class="flex items-center justify-between text-xs text-[var(--moka-muted)] font-mono uppercase tracking-wider">
            <span>{card.tag}</span>
            <span class="w-2 h-2 rounded-full bg-[var(--moka-butter)] opacity-60 group-hover:opacity-100 transition-opacity"></span>
          </div>

          <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-black/20">
            <img
              src={card.image}
              alt={card.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
          </div>

          <div class="space-y-2">
            <div class="font-script text-2xl text-[var(--moka-butter)]">{card.script}</div>
            <h3 class="font-display text-xl sm:text-2xl font-bold lowercase tracking-tight text-[var(--moka-froth)] leading-snug">
              {card.title}
            </h3>
            <p class="text-sm text-[var(--moka-muted)] leading-relaxed pt-2">
              {card.desc}
            </p>
          </div>
        </div>

        <div class="pt-8 mt-6 border-t border-[rgba(254,250,231,0.1)] flex items-baseline justify-between">
          <span class="font-display text-2xl font-black text-[var(--moka-froth)]">{card.stat}</span>
          <span class="text-[11px] uppercase tracking-wider text-[var(--moka-muted)]">{card.statLabel}</span>
        </div>
      </article>
    ))}
  </div>
</section>
