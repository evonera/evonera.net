---
interface Tile {
  title: string;
  label?: string;
  subtitle?: string;
  href: string;
  image: string;
}

interface Props {
  tiles: Tile[];
}

const { tiles } = Astro.props;
---

<section class="w-full bg-[var(--color-surface)] pb-16 sm:pb-24 px-4 sm:px-6">
  <div class="max-w-7xl mx-auto">
    <!-- Grid on Desktop, Horizontal Snap-Scroll on Mobile -->
    <div class="flex sm:grid sm:grid-cols-5 gap-3 sm:gap-4 overflow-x-auto sm:overflow-visible pb-4 sm:pb-0 snap-x snap-mandatory scrollbar-none px-1">
      {tiles.map((tile) => (
        <a
          href={tile.href}
          class="group relative flex-shrink-0 w-[74vw] sm:w-auto h-[380px] sm:h-[460px] md:h-[520px] rounded-2xl overflow-hidden snap-center focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] shadow-md transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
        >
          <!-- Photo -->
          <img
            src={tile.image}
            alt={tile.title}
            class="w-full h-full object-cover object-center transform transition-transform duration-700 group-hover:scale-105 filter brightness-[0.82] contrast-[1.05]"
            loading="lazy"
          />

          <!-- Dark Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/20 group-hover:from-black/90 transition-colors"></div>

          <!-- Bottom Label & Title -->
          <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6 flex flex-col justify-end text-[var(--color-on-primary)]">
            <span class="text-[10px] uppercase tracking-[0.25em] text-[var(--color-on-primary)]/70 font-medium mb-1">
              {tile.label || tile.subtitle}
            </span>
            <div class="inline-block">
              <span class="font-display text-2xl sm:text-2xl md:text-3xl font-light tracking-wide border-b border-[var(--color-on-primary)]/60 pb-1 group-hover:border-[var(--color-on-primary)] transition-colors">
                {tile.title}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Mobile Scroll Hint -->
    <div class="sm:hidden flex items-center justify-center gap-2 pt-3 text-[11px] text-[var(--color-ink)]/60 uppercase tracking-widest font-medium">
      <span>Swipe to explore chapters</span>
      <span>•</span>
      <span>1 of 5</span>
    </div>
  </div>
</section>
