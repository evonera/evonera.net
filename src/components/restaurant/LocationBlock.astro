---
interface Props {
  heading: string;
  subline: string;
  address: string;
  postalCode?: string;
  mrt: string;
  hours?: Record<string, string>;
  hoursText?: string;
  hoursSubtext?: string;
  phone: string;
  googleMapsUrl: string;
  mapTitle?: string;
}

const {
  heading,
  subline,
  address,
  postalCode = "Singapore",
  mrt,
  hoursText = "Mon - Sat: 11:30 AM - 8:00 PM",
  hoursSubtext = "Closed on Sundays",
  phone,
  googleMapsUrl,
  mapTitle = "Restaurant Location Map",
} = Astro.props;

const encodedAddress = encodeURIComponent(`${address} Singapore ${postalCode}`);
const mapEmbedSrc = `https://maps.google.com/maps?q=${encodedAddress}&t=&z=16&ie=UTF8&iwloc=&output=embed`;
---

<section class="w-full bg-[var(--color-primary)] text-[var(--color-on-primary)] py-20 sm:py-28 px-4 sm:px-6 border-t border-[var(--color-on-primary)]/10">
  <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
    <span class="text-xs uppercase tracking-[0.3em] text-[var(--color-on-primary)]/60 font-semibold mb-3">
      Visit Us
    </span>
    <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-light mb-3">
      {heading}
    </h2>
    <p class="text-base text-[var(--color-on-primary)]/80 font-light mb-12 max-w-lg">
      {subline}
    </p>

    <!-- White Rounded Location Card (Tavola Aperta style) -->
    <div class="w-full bg-white text-[#191919] rounded-[24px] p-6 sm:p-10 shadow-2xl text-left grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <!-- Address & Access Column -->
      <div class="md:col-span-6 flex flex-col gap-4">
        <div>
          <span class="text-[10px] uppercase tracking-[0.25em] text-[var(--color-primary)] font-bold block mb-1">
            Address
          </span>
          <p class="text-lg sm:text-xl font-medium text-[#191919]">
            {address}
          </p>
          <p class="text-sm text-neutral-500 mt-1">
            Singapore {postalCode}
          </p>
        </div>

        <div class="pt-2 border-t border-neutral-100">
          <span class="text-[10px] uppercase tracking-[0.25em] text-neutral-500 font-semibold block mb-1">
            Transit
          </span>
          <p class="text-sm text-neutral-700 font-medium">
            {mrt}
          </p>
        </div>

        <div class="pt-2 border-t border-neutral-100">
          <span class="text-[10px] uppercase tracking-[0.25em] text-neutral-500 font-semibold block mb-1">
            Dining Hours
          </span>
          <p class="text-sm text-neutral-800">
            <strong>Operating:</strong> {hoursText}<br />
            <span class="text-neutral-500 text-xs">{hoursSubtext}</span>
          </p>
        </div>

        <div class="pt-2">
          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs uppercase tracking-wider text-[var(--color-primary)] font-semibold underline hover:opacity-80 transition-opacity"
          >
            <span>Open in Google Maps</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Map Graphic / Directions Card Visual -->
      <div class="md:col-span-6 h-[260px] sm:h-[300px] w-full rounded-2xl overflow-hidden relative border border-neutral-200 bg-neutral-100">
        <iframe
          title={mapTitle}
          width="100%"
          height="100%"
          style="border:0;"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          src={mapEmbedSrc}
          class="w-full h-full filter saturate-[0.85] contrast-[1.05]"
        ></iframe>
      </div>
    </div>
  </div>
</section>
