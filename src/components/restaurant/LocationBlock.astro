---
interface Props {
  heading: string;
  subline: string;
  address: string;
  mrt: string;
  hours: Record<string, string>;
  phone: string;
  googleMapsUrl: string;
}

const { heading, subline, address, mrt, hours, phone, googleMapsUrl } = Astro.props;
---

<section class="w-full bg-[#4A0D1C] text-[#FDF1DC] py-20 sm:py-28 px-4 sm:px-6 border-t border-[#FDF1DC]/10">
  <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
    <span class="text-xs uppercase tracking-[0.3em] text-[#FDF1DC]/60 font-semibold mb-3">
      Visit Us
    </span>
    <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-light mb-3">
      {heading}
    </h2>
    <p class="text-base text-[#FDF1DC]/80 font-light mb-12 max-w-lg">
      {subline}
    </p>

    <!-- White Rounded Location Card (Tavola Aperta style) -->
    <div class="w-full bg-white text-[#191919] rounded-[24px] p-6 sm:p-10 shadow-2xl text-left grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <!-- Address & Access Column -->
      <div class="md:col-span-6 flex flex-col gap-4">
        <div>
          <span class="text-[10px] uppercase tracking-[0.25em] text-[#4A0D1C] font-bold block mb-1">
            Address
          </span>
          <p class="text-lg sm:text-xl font-medium text-[#191919]">
            {address}
          </p>
          <p class="text-sm text-neutral-500 mt-1">
            Singapore 228796
          </p>
        </div>

        <div class="pt-2 border-t border-neutral-100">
          <span class="text-[10px] uppercase tracking-[0.25em] text-neutral-500 font-semibold block mb-1">
            Transit
          </span>
          <p class="text-sm text-neutral-700 font-medium">
            {mrt}
          </p>
        </div>

        <div class="pt-2 border-t border-neutral-100">
          <span class="text-[10px] uppercase tracking-[0.25em] text-neutral-500 font-semibold block mb-1">
            Dining Hours
          </span>
          <p class="text-sm text-neutral-800">
            <strong>Mon - Sat:</strong> 7:00 PM - 10:00 PM<br />
            <span class="text-neutral-500 text-xs">Closed on Sundays • Single seating at 7:00 PM</span>
          </p>
        </div>

        <div class="pt-2">
          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs uppercase tracking-wider text-[#4A0D1C] font-semibold underline hover:opacity-80 transition-opacity"
          >
            <span>Open in Google Maps</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Map Graphic / Directions Card Visual -->
      <div class="md:col-span-6 h-[260px] sm:h-[300px] w-full rounded-2xl overflow-hidden relative border border-neutral-200 bg-neutral-100">
        <iframe
          title="Toriei Cuppage Plaza Map"
          width="100%"
          height="100%"
          style="border:0;"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          src="https://maps.google.com/maps?q=Toriei%20Yakitori%20Omakase%20Cuppage%20Plaza%20Singapore&t=&z=17&ie=UTF8&iwloc=&output=embed"
          class="w-full h-full filter grayscale-[0.2] contrast-[1.05] brightness-[0.96]"
        ></iframe>
      </div>
    </div>
  </div>
</section>
