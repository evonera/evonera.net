---
interface CarouselItem {
  image: string;
  caption: string;
}

interface Props {
  items: CarouselItem[];
}

const { items } = Astro.props;
---

<section class="w-full bg-[#4A0D1C] text-[#FDF1DC] py-16 sm:py-24 overflow-hidden border-t border-[#FDF1DC]/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header with Section Title and Arrow Navigation Buttons -->
    <div class="flex items-end justify-between mb-8 sm:mb-12">
      <div>
        <span class="text-xs uppercase tracking-[0.3em] text-[#FDF1DC]/60 font-semibold block mb-2">
          At The Counter
        </span>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-light">
          Moments on the Grill
        </h2>
      </div>

      <!-- Arrow Controls -->
      <div class="flex items-center gap-3">
        <button
          type="button"
          id="carousel-prev"
          aria-label="Previous photo"
          class="w-12 h-12 rounded-full border border-[#FDF1DC]/30 flex items-center justify-center text-[#FDF1DC] hover:bg-[#FDF1DC] hover:text-[#4A0D1C] transition-all focus:outline-none focus:ring-2 focus:ring-[#FDF1DC]"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          id="carousel-next"
          aria-label="Next photo"
          class="w-12 h-12 rounded-full border border-[#FDF1DC]/30 flex items-center justify-center text-[#FDF1DC] hover:bg-[#FDF1DC] hover:text-[#4A0D1C] transition-all focus:outline-none focus:ring-2 focus:ring-[#FDF1DC]"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Carousel Container -->
    <div
      id="photo-carousel-track"
      class="flex gap-4 sm:gap-6 overflow-x-auto pb-6 scroll-smooth snap-x snap-mandatory scrollbar-none"
      tabindex="0"
      role="region"
      aria-roledescription="carousel"
      aria-label="Toriei photo gallery"
    >
      {items.map((item, index) => (
        <div
          class="flex-shrink-0 w-[78vw] sm:w-[380px] md:w-[420px] h-[480px] sm:h-[540px] rounded-2xl overflow-hidden relative snap-start group shadow-lg"
          role="group"
          aria-roledescription="slide"
          aria-label={`Slide ${index + 1} of ${items.length}: ${item.caption}`}
        >
          <img
            src={item.image}
            alt={item.caption}
            class="w-full h-full object-cover object-center transform transition-transform duration-700 group-hover:scale-105 filter brightness-[0.9]"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-80 group-hover:opacity-95 transition-opacity"></div>
          <div class="absolute inset-x-0 bottom-0 p-6 text-[#FDF1DC]">
            <span class="text-[10px] uppercase tracking-[0.25em] text-[#C5A059] font-medium block mb-1">
              Course 0{index + 1}
            </span>
            <p class="text-sm font-light leading-snug text-[#FDF1DC]/90">
              {item.caption}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const track = document.getElementById("photo-carousel-track");
  const prevBtn = document.getElementById("carousel-prev");
  const nextBtn = document.getElementById("carousel-next");

  function scrollByCard(direction: number) {
    if (!track) return;
    const cardWidth = track.firstElementChild?.clientWidth || 380;
    track.scrollBy({ left: direction * (cardWidth + 24), behavior: "smooth" });
  }

  prevBtn?.addEventListener("click", () => scrollByCard(-1));
  nextBtn?.addEventListener("click", () => scrollByCard(1));

  // Keyboard support when focused
  track?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") {
      e.preventDefault();
      scrollByCard(-1);
    } else if (e.key === "ArrowRight") {
      e.preventDefault();
      scrollByCard(1);
    }
  });
</script>
