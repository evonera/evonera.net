---
import CornerFrame from "./CornerFrame.astro";

interface BentoItem {
  tag: string;
  title: string;
  koreanTitle?: string;
  description: string;
  priceNote?: string;
  image: string;
  href: string;
  colSpan?: string;
  highlightBadge?: string;
}

const bentoItems: BentoItem[] = [
  {
    tag: "SIGNATURE BROTH",
    title: "4-Hour Pork Bone Gamjatang",
    koreanTitle: "감자탕",
    description: "Soaked 4 hours to eliminate gaminess, simmered on gentle heat with 3 Gochugaru varieties, tender potatoes, and fresh perilla leaves.",
    priceNote: "Lunch from S$15.80 • Sharing Pots from S$53",
    image: "/demo/gamja/tile-2.jpg",
    href: "/demo/gamja/menu",
    colSpan: "lg:col-span-7",
    highlightBadge: "Chef Nam's Masterpiece",
  },
  {
    tag: "VIRAL SENSATION",
    title: "Flame-Torched Fiery Ppyeogui",
    koreanTitle: "뼈구이",
    description: "Tender braised pork spine torched with high-heat flames and glazed in smoky spicy chili glaze.",
    priceNote: "S$48.00 • Ideal for 2-3 to share",
    image: "/demo/gamja/carousel-4.jpg",
    href: "/demo/gamja/menu",
    colSpan: "lg:col-span-5",
    highlightBadge: "Viral Flame-Torched",
  },
  {
    tag: "EXCLUSIVE EXPERIENCE",
    title: "Cauldron-Lid Cast-Iron K-BBQ",
    koreanTitle: "솥뚜껑 삼겹살",
    description: "Duroc pork belly and aged kimchi sizzled on traditional inverted cast-iron cauldron lids.",
    priceNote: "5 Tables Daily Limit • Advance Booking Recommended",
    image: "/demo/gamja/tile-3.jpg",
    href: "/demo/gamja/reservations",
    colSpan: "lg:col-span-5",
    highlightBadge: "5 Tables Daily",
  },
  {
    tag: "CBD DAY-DRINKING",
    title: "Lunch Pocha & Refreshing Drinks",
    koreanTitle: "점심 낮술 50% 할인",
    description: "Crispy Korean pancakes, homemade banchan, and 50% off Terra beer, Jinro soju, and fresh makgeolli during weekday lunch.",
    priceNote: "50% Off Lunch Drinks • Monday - Friday",
    image: "/demo/gamja/tile-4.jpg",
    href: "/demo/gamja/menu",
    colSpan: "lg:col-span-7",
    highlightBadge: "50% Off Lunch",
  },
];
---

<section class="relative w-full bg-[#0A0B0A] text-[#F5EFEB] py-20 sm:py-28 px-4 sm:px-6 lg:px-8 border-b border-white/5">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header in Qitchen Classical Serif Style -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.25em] text-[#DAC5A7] font-medium mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-[#DAC5A7]"></span>
          <span>THE EXPERIENCE • SOUL OF SEOUL</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-normal text-white leading-tight">
          Where Slow Simmer Meets Vibrant CBD Pocha
        </h2>
      </div>
      <div class="md:text-right flex-shrink-0">
        <a
          href="/demo/gamja/menu"
          class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-[#DAC5A7] hover:text-white transition-colors group"
        >
          <span>View All Offerings</span>
          <span class="transform group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>

    <!-- 4-Card Asymmetric Bento Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8">
      {bentoItems.map((item) => (
        <div class={`${item.colSpan} w-full`}>
          <CornerFrame class="bg-[#141312] overflow-hidden group h-full flex flex-col justify-between hover:border-[#DAC5A7]/40 transition-all duration-300">
            <!-- Image Area -->
            <div class="relative h-64 sm:h-72 lg:h-80 w-full overflow-hidden">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover object-center filter brightness-[0.88] contrast-[1.05] transform group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#141312] via-transparent to-black/40"></div>

              <!-- Top Left Tag -->
              <div class="absolute top-4 left-4 z-10 flex items-center gap-2">
                <span class="px-3 py-1 rounded-full bg-black/60 backdrop-blur-md border border-white/15 text-[10px] uppercase tracking-widest text-[#DAC5A7] font-semibold">
                  {item.tag}
                </span>
                {item.highlightBadge && (
                  <span class="px-2.5 py-1 rounded-full bg-[#C23B22]/80 backdrop-blur-md border border-[#C23B22] text-[10px] uppercase tracking-wider text-white font-medium">
                    {item.highlightBadge}
                  </span>
                )}
              </div>
            </div>

            <!-- Content Area -->
            <div class="p-6 sm:p-7 flex flex-col justify-between flex-grow">
              <div class="mb-6">
                <div class="flex items-baseline gap-2 mb-2">
                  <h3 class="font-display text-2xl sm:text-3xl font-normal text-white group-hover:text-[#DAC5A7] transition-colors">
                    {item.title}
                  </h3>
                  {item.koreanTitle && (
                    <span class="text-sm font-light text-[#DAC5A7]/70">
                      {item.koreanTitle}
                    </span>
                  )}
                </div>
                <p class="text-sm text-[#F5EFEB]/70 leading-relaxed font-light">
                  {item.description}
                </p>
              </div>

              <!-- Bottom Bar with Price Note & Corner Arrow Button -->
              <div class="pt-4 border-t border-white/10 flex items-center justify-between">
                <span class="text-xs text-[#DAC5A7] font-medium tracking-wide">
                  {item.priceNote}
                </span>
                <a
                  href={item.href}
                  class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-white/[0.06] hover:bg-[#DAC5A7] text-[#DAC5A7] hover:text-[#0A0B0A] border border-white/10 hover:border-[#DAC5A7] transition-all duration-200"
                  aria-label={`Explore ${item.title}`}
                >
                  <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          </CornerFrame>
        </div>
      ))}
    </div>

  </div>
</section>
