---
import CornerFrame from "./CornerFrame.astro";

interface Props {
  headline: string;
  subline: string;
  heroImage: string;
  ctaText?: string;
  ctaHref?: string;
  menuHref?: string;
}

const {
  headline = "Four Hours of Simmer. The Pure Soul of Gamjatang.",
  subline = "Hand-soaked pork bones, Chef Nam's signature 3-Gochugaru chili broth, fall-off-the-bone tender ribs, and sizzling cast-iron BBQ at 21 Boon Tat Street.",
  heroImage = "/demo/gamja/hero.jpg",
  ctaText = "Reserve a Table",
  ctaHref = "/demo/gamja/reservations",
  menuHref = "/demo/gamja/menu",
} = Astro.props;
---

<section class="relative w-full bg-[#0A0B0A] text-[#F5EFEB] pt-12 pb-20 sm:pt-16 sm:pb-28 px-4 sm:px-6 lg:px-8 border-b border-white/5 overflow-hidden">
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[radial-gradient(ellipse_at_center,rgba(194,59,34,0.12),transparent_70%)] pointer-events-none blur-3xl"></div>

  <div class="max-w-7xl mx-auto">
    <!-- Grid: Editorial Statement on Left, Featured Visual Card on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Col 1: Editorial Typography (7 cols on lg) -->
      <div class="lg:col-span-7 flex flex-col items-start z-10">
        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-[#DAC5A7]/30 text-[#DAC5A7] text-[10px] sm:text-xs uppercase tracking-[0.28em] font-medium mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C23B22] animate-pulse"></span>
          <span>21 BOON TAT STREET • TELOK AYER CBD</span>
        </div>

        <!-- Grand Roman Serif Display Headline -->
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-[68px] font-normal leading-[1.08] tracking-tight text-white mb-6">
          {headline}
        </h1>

        <!-- Subline -->
        <p class="text-base sm:text-lg text-[#F5EFEB]/75 font-light leading-relaxed max-w-xl mb-8">
          {subline}
        </p>

        <!-- CTA Button Group -->
        <div class="flex flex-wrap items-center gap-4 mb-10">
          <a
            href={ctaHref}
            class="group inline-flex items-center gap-2.5 font-medium rounded-full bg-[#DAC5A7] text-[#0A0B0A] text-xs sm:text-sm uppercase tracking-widest px-8 py-4 shadow-lg hover:bg-white hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
          >
            <span>{ctaText}</span>
            <span class="transform group-hover:translate-x-1 transition-transform">→</span>
          </a>

          <a
            href={menuHref}
            class="inline-flex items-center gap-2 font-medium rounded-full bg-white/[0.04] hover:bg-white/[0.08] border border-white/15 text-[#F5EFEB] text-xs sm:text-sm uppercase tracking-widest px-7 py-4 transition-all duration-200"
          >
            <span>Explore Menu</span>
          </a>
        </div>

        <!-- The Potato Philosophy Quote Box -->
        <div class="w-full max-w-xl p-4 sm:p-5 rounded-xl bg-white/[0.02] border border-white/10 flex items-start gap-3.5">
          <span class="text-xl sm:text-2xl flex-shrink-0 text-[#DAC5A7]">🥔</span>
          <p class="text-xs sm:text-sm text-[#F5EFEB]/70 italic leading-relaxed">
            "Potatoes are never the main character, but the ultimate partner that completes every delicious moment at GAMJA."
            <span class="block text-[10px] uppercase tracking-widest text-[#DAC5A7] font-semibold not-italic mt-1.5">- Master Chef Nam Wan-Hyuk</span>
          </p>
        </div>
      </div>

      <!-- Col 2: Featured Visual Bento Spotlight (5 cols on lg) -->
      <div class="lg:col-span-5 w-full z-10">
        <CornerFrame class="bg-[#141312] overflow-hidden shadow-2xl group">
          <!-- Main Hero Image -->
          <div class="relative h-[420px] sm:h-[480px] w-full overflow-hidden">
            <img
              src={heroImage}
              alt="GAMJA Signature 4-Hour Simmered Gamjatang"
              class="w-full h-full object-cover object-center filter brightness-[0.88] contrast-[1.05] transform group-hover:scale-105 transition-transform duration-700"
              loading="eager"
            />
            <!-- Dark Vignette Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#0A0B0A] via-transparent to-black/30"></div>

            <!-- Top Floating Tag -->
            <div class="absolute top-4 left-4 z-10">
              <span class="px-3 py-1 rounded-full bg-black/60 backdrop-blur-md border border-white/15 text-[10px] uppercase tracking-widest text-[#DAC5A7] font-semibold">
                Signature Broth
              </span>
            </div>

            <!-- Bottom Information Card Overlay -->
            <div class="absolute inset-x-0 bottom-0 p-6 z-10 flex items-end justify-between">
              <div>
                <span class="text-[10px] uppercase tracking-[0.25em] text-[#DAC5A7] font-bold block mb-1">
                  Pork Bone & Potato Stew
                </span>
                <p class="font-display text-2xl font-normal text-white">
                  Traditional Gamjatang
                </p>
                <p class="text-xs text-[#F5EFEB]/70 mt-1">
                  Lunch from S$15.80 • Sharing Pots from S$53
                </p>
              </div>

              <!-- Corner Pill Button -->
              <a
                href={menuHref}
                class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-[#DAC5A7] text-[#0A0B0A] hover:bg-white transition-colors shadow-md flex-shrink-0"
                aria-label="View menu item"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </CornerFrame>
      </div>

    </div>
  </div>
</section>
