---
import { SEO } from "astro-seo";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Evonera Technologies — Finish Your AI-Built App",
  description = "Evonera Technologies helps founders finish, fix, and launch web apps started with Lovable, Emergent, and other AI builders.",
  image = "/og/evonera.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://evonera.net").toString();
const ogImageURL = new URL(image, Astro.site || "https://evonera.net").toString();

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/images/evonera-logo.jpg" type="image/jpeg" />
    <meta name="theme-color" content="#191919" />
    <meta name="color-scheme" content="dark" />

    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: ogImageURL,
          url: canonicalURL,
        },
        optional: {
          description,
          siteName: "Evonera Technologies Pvt Ltd",
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: "@evonera",
        creator: "@evonera",
        title,
        description,
        image: ogImageURL,
      }}
    />
  </head>
  <body class="min-h-screen bg-ink-950 text-neutral-200 font-sans flex flex-col selection:bg-blue-600 selection:text-white">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-ink-950 border-b border-white/15">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
        <a href="/" class="inline-flex items-center gap-2.5 text-neutral-100 group">
          <img src="/images/evonera-logo.jpg" alt="" class="size-7 rounded-md object-cover" width="28" height="28" />
          <span class="font-medium text-base tracking-tight">Evonera</span>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm text-neutral-300">
          <a href="/fix-my-ai-site" class="hover:text-white transition-colors">AI app rescue</a>
          <a href="/restaurants" class="hover:text-white transition-colors">Restaurant websites</a>
          <a href="/services" class="hover:text-white transition-colors">Services</a>
          <a href="/#how-it-works" class="hover:text-white transition-colors">How it works</a>
          <a href="/contact" class="hover:text-white transition-colors">Contact</a>
        </nav>

        <div class="flex items-center gap-2">
          <a
            href="/fix-my-ai-site#project-review"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md text-xs font-medium bg-blue-600 hover:bg-blue-500 text-white shadow-sm transition-transform active:scale-95"
          >
            <span>Get project help</span>
          </a>
          <button id="menu-btn" aria-expanded="false" aria-label="Open menu" class="md:hidden size-9 inline-flex items-center justify-center rounded-md border border-white/15 bg-ink-800 text-neutral-200">
            ☰
          </button>
        </div>
      </div>
      <nav id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-ink-950">
        <div class="px-4 py-3 flex flex-col gap-1 text-sm text-neutral-300">
          <a href="/fix-my-ai-site" class="py-2 border-b border-white/10">AI app rescue</a>
          <a href="/restaurants" class="py-2 border-b border-white/10">Restaurant websites</a>
          <a href="/services" class="py-2 border-b border-white/10">Services</a>
          <a href="/#how-it-works" class="py-2 border-b border-white/10">How it works</a>
          <a href="/pricing" class="py-2 border-b border-white/10">Pricing</a>
          <a href="/contact" class="py-2">Contact</a>
        </div>
      </nav>
    </header>

    <!-- Main Body -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/10 bg-ink-900 py-16 px-4 sm:px-6 text-sm font-sans">
      <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="space-y-3 md:col-span-2">
          <div class="flex items-center gap-2">
            <img src="/images/evonera-logo.jpg" alt="" class="size-6 rounded object-cover" width="24" height="24" />
          <span class="font-medium text-neutral-100">Evonera Technologies Pvt Ltd</span>
          </div>
          <p class="text-xs text-neutral-400 max-w-sm leading-relaxed">
            We build bespoke websites for modern businesses and restaurants, and help founders finish and launch web apps started with AI builders.
          </p>
          <div class="text-xs font-mono text-faint pt-1">
            Bespoke Web & App Engineering · Fixed scope and price agreed before work begins.
          </div>
        </div>

        <div class="space-y-2">
          <p class="font-mono text-xs font-medium text-neutral-200 uppercase tracking-wider">Explore</p>
          <ul class="space-y-1.5 text-xs text-neutral-400">
            <li><a href="/restaurants" class="hover:text-neutral-200 transition-colors">Restaurant & Dining Websites →</a></li>
            <li><a href="/fix-my-ai-site" class="text-blue-300 hover:text-white transition-colors">Finish your AI-built app →</a></li>
            <li><a href="/services" class="hover:text-neutral-200 transition-colors">Engineering Services →</a></li>
            <li><a href="/pricing" class="hover:text-neutral-200 transition-colors">How pricing works →</a></li>
            <li><a href="/blog" class="hover:text-neutral-200 transition-colors">Engineering Blog →</a></li>
          </ul>
        </div>

        <div class="space-y-2">
          <p class="font-mono text-xs font-medium text-neutral-200 uppercase tracking-wider">Company</p>
          <ul class="space-y-1.5 text-xs text-neutral-400">
            <li><a href="/pricing" class="hover:text-neutral-200 transition-colors">How pricing works</a></li>
            <li><a href="/contact" class="hover:text-neutral-200 transition-colors">Contact</a></li>
            <li><a href="/privacy" class="hover:text-neutral-200 transition-colors">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-neutral-200 transition-colors">Terms of Service</a></li>
          </ul>
        </div>
      </div>

      <div class="max-w-6xl mx-auto mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-faint font-mono">
        <p>© {new Date().getFullYear()} Evonera Technologies Pvt Ltd. All rights reserved.</p>
        <p>Bespoke Websites · App Engineering · AI Project Rescue</p>
      </div>
    </footer>

    <script>
      const menuButton = document.getElementById("menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      menuButton?.addEventListener("click", () => {
        const isExpanded = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!isExpanded));
        mobileMenu?.classList.toggle("hidden", isExpanded);
      });
      mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          menuButton?.setAttribute("aria-expanded", "false");
        });
      });
    </script>
  </body>
</html>
