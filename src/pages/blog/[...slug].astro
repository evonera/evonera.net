---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} — Evonera Blog`}
  description={post.data.description}
  image={post.data.heroImage}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 pt-16 pb-20 font-sans">
    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-white/10">
      <div class="flex items-center gap-3 text-xs font-mono mb-4">
        <a href="/blog" class="text-neutral-400 hover:text-white transition-colors">← Back to Blog</a>
        <span>•</span>
        <span class="text-blue-300 bg-ink-800 px-2 py-0.5 rounded border border-blue-500/30">
          {post.data.category}
        </span>
        <span>•</span>
        <span class="text-faint">{post.data.readingTime}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-medium text-neutral-100 tracking-tight leading-[1.2]">
        {post.data.title}
      </h1>

      <div class="mt-6 flex items-center justify-between text-xs font-mono text-faint">
        <div class="flex items-center gap-2">
          <div class="size-6 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-[10px]">
            E
          </div>
          <span class="text-neutral-300">{post.data.author}</span>
        </div>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      </div>
    </header>

    {post.data.heroImage && (
      <div class="mb-10 rounded-xl overflow-hidden border border-white/10 bg-ink-900 aspect-[16/9]">
        <img
          src={post.data.heroImage}
          alt={post.data.title}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <!-- Article Markdown Content -->
    <div class="prose prose-invert max-w-none text-neutral-300 text-base leading-relaxed space-y-6">
      <Content />
    </div>

    <!-- Bottom Author & Engagement Box -->
    <div class="mt-16 p-8 rounded-xl border border-white/15 bg-ink-900 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div class="space-y-1 max-w-md">
        <h3 class="text-base font-medium text-neutral-100">Need help finishing your AI-built app?</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">
          We help founders finish, fix, and launch apps started with Lovable, Emergent, and other AI builders.
        </p>
      </div>
      <a
        href="/fix-my-ai-site#project-review"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-xs shadow transition-transform active:scale-95 shrink-0"
      >
        Get project help →
      </a>
    </div>
  </article>
</Layout>
