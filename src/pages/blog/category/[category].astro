---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const uniqueCategories = Array.from(
    new Set(allPosts.map((post) => post.data.category))
  );

  return uniqueCategories.map((category) => {
    const slug = category.toLowerCase().replace(/\s+/g, "-");
    const filteredPosts = allPosts
      .filter((post) => post.data.category === category)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { category: slug },
      props: { category, posts: filteredPosts, allCategories: uniqueCategories },
    };
  });
}

const { category, posts, allCategories } = Astro.props;
---

<Layout
  title={`${category} Articles — Evonera Blog`}
  description={`Technical articles and engineering breakdowns in ${category} by Evonera.`}
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-16 pb-20">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono mb-2">
        <a href="/blog" class="text-neutral-400 hover:text-white transition-colors">← All Articles</a>
      </div>
      <h1 class="text-4xl sm:text-5xl font-medium text-neutral-100 mt-1">
        {category}
      </h1>
      <p class="mt-3 text-sm text-neutral-400">
        Showing {posts.length} {posts.length === 1 ? "article" : "articles"} in this category.
      </p>
    </div>

    <!-- Category Pills -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
      <a
        href="/blog"
        class="px-3.5 py-1.5 rounded-full text-xs font-mono border border-white/15 bg-ink-900 text-neutral-300 hover:text-white hover:bg-ink-800 transition-colors"
      >
        All Articles
      </a>
      {allCategories.map((cat) => {
        const isCurrent = cat === category;
        return (
          <a
            href={`/blog/category/${encodeURIComponent(cat.toLowerCase().replace(/\s+/g, "-"))}`}
            class={`px-3.5 py-1.5 rounded-full text-xs font-mono transition-colors ${
              isCurrent
                ? "bg-blue-600 text-white font-medium shadow-sm"
                : "border border-white/15 bg-ink-900 text-neutral-300 hover:text-white hover:bg-ink-800"
            }`}
          >
            {cat}
          </a>
        );
      })}
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {posts.map((post) => (
        <article class="rounded-xl border border-white/15 bg-ink-900 overflow-hidden hover:border-blue-500/50 transition-colors flex flex-col justify-between group">
          {post.data.heroImage && (
            <a href={`/blog/${post.id}`} class="block overflow-hidden border-b border-white/10 aspect-[16/9] bg-ink-900">
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
              />
            </a>
          )}
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-[11px] font-mono text-faint mb-2.5">
                <span class="text-blue-300 bg-ink-800 px-2 py-0.5 rounded border border-blue-500/30">
                  {post.data.category}
                </span>
                <span>{post.data.readingTime}</span>
              </div>
              <h2 class="text-lg font-medium text-neutral-100 group-hover:text-blue-400 transition-colors line-clamp-2">
                <a href={`/blog/${post.id}`}>
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2.5 text-xs text-neutral-400 leading-relaxed line-clamp-3">
                {post.data.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-faint">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
              <span class="text-blue-400 group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1">
                Read Article →
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
