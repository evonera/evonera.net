---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = Array.from(new Set(posts.map((post) => post.data.category)));
---

<Layout
  title="Evonera Engineering Blog — AI, Architecture & Tooling"
  description="Technical deep dives on Agentic Engineering, modern UI component libraries, Repomix context tooling, and high-performance software architecture."
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-16 pb-20">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <span class="text-xs font-mono uppercase tracking-widest text-blue-400">Evonera Research</span>
      <h1 class="text-4xl sm:text-5xl font-medium text-neutral-100 mt-2">
        Engineering & Architecture Blog
      </h1>
      <p class="mt-4 text-base text-neutral-400">
        Practical insights on multi-agent systems, frontend design systems, and modern AI developer tooling.
      </p>
    </div>

    <!-- Category Pills Filter -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
      <a
        href="/blog"
        class="px-3.5 py-1.5 rounded-full text-xs font-mono bg-blue-600 text-white font-medium shadow-sm transition-colors"
      >
        All Articles ({posts.length})
      </a>
      {categories.map((category) => (
        <a
          href={`/blog/category/${encodeURIComponent(category.toLowerCase().replace(/\s+/g, "-"))}`}
          class="px-3.5 py-1.5 rounded-full text-xs font-mono border border-white/15 bg-ink-900 text-neutral-300 hover:text-white hover:bg-ink-800 transition-colors"
        >
          {category}
        </a>
      ))}
    </div>

    <!-- Blog Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {posts.map((post) => (
        <article class="rounded-xl border border-white/15 bg-ink-900 overflow-hidden hover:border-blue-500/50 transition-colors flex flex-col justify-between group">
          {post.data.heroImage && (
            <a href={`/blog/${post.id}`} class="block overflow-hidden border-b border-white/10 aspect-[16/9] bg-ink-900">
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
              />
            </a>
          )}
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-[11px] font-mono text-faint mb-2.5">
                <span class="text-blue-300 bg-ink-800 px-2 py-0.5 rounded border border-blue-500/30">
                  {post.data.category}
                </span>
                <span>{post.data.readingTime}</span>
              </div>
              <h2 class="text-lg font-medium text-neutral-100 group-hover:text-blue-400 transition-colors line-clamp-2">
                <a href={`/blog/${post.id}`}>
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2.5 text-xs text-neutral-400 leading-relaxed line-clamp-3">
                {post.data.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-faint">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
              <span class="text-blue-400 group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1">
                Read Article →
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
