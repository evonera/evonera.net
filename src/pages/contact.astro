---
import Layout from "../layouts/Layout.astro";
import { ProjectBriefForm } from "../components/ProjectBriefForm";
---

<Layout title="Contact Evonera Technologies — Bespoke Websites & Software Engineering" description="Tell Evonera about your project or unfinished AI-built app and get a fast scope review.">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 sm:pt-24 pb-16">
    <div class="max-w-2xl mx-auto text-center mb-8">
      <p class="text-sm font-medium text-blue-300">Contact</p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-semibold text-neutral-50">Tell us about your project.</h1>
      <p class="mt-4 text-base text-neutral-300 leading-relaxed">Share what you’re building, your website goals, or what is unfinished. If you prefer, email us directly at <a href="mailto:connect@evonera.net" class="text-blue-300 underline underline-offset-4">connect@evonera.net</a>.</p>
    </div>
    <ProjectBriefForm client:load />
  </section>
</Layout>
