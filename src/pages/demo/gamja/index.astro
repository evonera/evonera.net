---
import RestaurantDemoLayout from "../../../layouts/RestaurantDemoLayout.astro";
import QitchenHero from "../../../components/restaurant/qitchen/QitchenHero.astro";
import QitchenBento from "../../../components/restaurant/qitchen/QitchenBento.astro";
import QitchenMenuShowcase from "../../../components/restaurant/qitchen/QitchenMenuShowcase.astro";
import QitchenStory from "../../../components/restaurant/qitchen/QitchenStory.astro";
import QitchenReservationBento from "../../../components/restaurant/qitchen/QitchenReservationBento.astro";
import QitchenFooter from "../../../components/restaurant/qitchen/QitchenFooter.astro";

import data from "../../../data/restaurants/gamja.json";

const { restaurant, hero, story } = data;
---

<RestaurantDemoLayout
  restaurantData={data}
  title={`${restaurant.name} | ${restaurant.tagline}`}
  description={hero.subline}
  currentPath="/demo/gamja"
  hideFooter={true}
>
  <!-- 1. Qitchen Classical Serif Hero Section with Corner Frame -->
  <QitchenHero
    headline={hero.headline}
    subline={hero.subline}
    heroImage={hero.image}
    ctaText="Reserve a Table"
    ctaHref="/demo/gamja/reservations"
    menuHref="/demo/gamja/menu"
  />

  <!-- 2. Signature 4-Card Asymmetric Bento Grid (Gamjatang, Ppyeogui, K-BBQ, Day-Drinking) -->
  <QitchenBento />

  <!-- 3. Dual-Column Menu Showcase with Dotted Leaders & Badges -->
  <QitchenMenuShowcase />

  <!-- 4. The Founders' Story & Philosophy (Chef Nam Wan-Hyuk & Shin Jae-Yoon) -->
  <QitchenStory chefImage={story.image} />

  <!-- 5. Dual Reservation Card (MyNeon Online Booking + WhatsApp Concierge) -->
  <QitchenReservationBento
    myNeonUrl="https://myneon.me/?m=booking&sno=1500"
    phone={restaurant.phone}
    whatsapp={restaurant.whatsapp}
  />

  <!-- 6. Architectural Qitchen Footer -->
  <QitchenFooter
    restaurantName={restaurant.name}
    address={`${restaurant.address}, ${restaurant.city} ${restaurant.postalCode}`}
    phone={restaurant.phone}
    instagram={restaurant.social.instagram}
  />
</RestaurantDemoLayout>
