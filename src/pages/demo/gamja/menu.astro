---
import RestaurantDemoLayout from "../../../layouts/RestaurantDemoLayout.astro";
import data from "../../../data/restaurants/gamja.json";

const { restaurant, menu } = data;
---

<RestaurantDemoLayout
  restaurantData={data}
  title={`Menu & Courses | ${restaurant.name} Singapore`}
  description={`Explore ${restaurant.name}'s authentic Korean comfort menu at 21 Boon Tat Street. Slow-simmered pork bone Gamjatang bowls from ${menu.basePrice}, cast-iron KBBQ, and sharing hotpots.`}
  currentPath="/demo/gamja/menu"
>
  <!-- Subpage Header -->
  <section class="w-full text-[var(--color-on-primary)] pt-28 pb-16 sm:pt-36 sm:pb-20 px-4 sm:px-6 text-center border-b border-[var(--color-on-primary)]/10" style="background-color: color-mix(in srgb, var(--color-primary) 90%, black);">
    <div class="max-w-3xl mx-auto">
      <span class="text-xs uppercase tracking-[0.3em] text-[var(--color-accent)] font-semibold mb-3 block">
        Korean Soul Food & Gamjatang Specialty
      </span>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-light tracking-tight mb-4 text-[var(--color-on-primary)]">
        {menu.title}
      </h1>
      <p class="text-lg text-[var(--color-on-primary)]/85 font-light leading-relaxed max-w-xl mx-auto mb-6">
        {menu.description}
      </p>
      <div class="inline-flex items-center gap-4 px-6 py-2 rounded-full bg-[var(--color-on-primary)]/10 border border-[var(--color-on-primary)]/20 text-[var(--color-on-primary)] text-sm">
        <span class="font-semibold text-[var(--color-accent)]">{menu.price}</span>
        <span>•</span>
        <span>Steamed Rice & Free Banchan</span>
        <span>•</span>
        <span>4-Hour Simmered Broth</span>
      </div>
    </div>
  </section>

  <!-- Menu Body (Warm Surface with Ink Text) -->
  <section class="w-full bg-[var(--color-surface)] text-[var(--color-ink)] py-20 sm:py-28 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto space-y-16">
      {menu.categories.map((cat, idx) => (
        <div class="border-b border-[var(--color-ink)]/20 pb-12 last:border-b-0">
          <!-- Category Header -->
          <div class="flex items-baseline justify-between mb-8 pb-3 border-b-2 border-[var(--color-ink)]">
            <div>
              <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-light text-[var(--color-ink)]">
                {cat.name}
              </h2>
              {cat.description && (
                <p class="text-xs text-[var(--color-ink)]/60 mt-1 font-light">
                  {cat.description}
                </p>
              )}
            </div>
            <span class="text-xs uppercase tracking-widest text-[var(--color-ink)]/60 font-medium">
              Section 0{idx + 1}
            </span>
          </div>

          <!-- Items Grid -->
          <div class="space-y-6">
            {cat.items.map((item) => (
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 sm:gap-6 py-3 border-b border-[var(--color-ink)]/10 last:border-b-0">
                <div class="flex-grow">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="font-display text-lg sm:text-xl font-medium text-[var(--color-ink)]">
                      {item.name}
                    </h3>
                    {item.dietary && item.dietary.map((d: string) => (
                      <span class={`text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-full font-semibold ${
                        d === "Signature" || d === "Must Try"
                          ? "bg-[var(--color-primary)] text-[var(--color-surface)]"
                          : "bg-[var(--color-ink)]/10 text-[var(--color-ink)]"
                      }`}>
                        {d}
                      </span>
                    ))}
                  </div>
                  <p class="text-xs sm:text-sm text-[var(--color-ink)]/75 font-light leading-relaxed mt-1">
                    {item.description}
                  </p>
                </div>
                <div class="text-sm sm:text-base font-semibold text-[var(--color-ink)] flex-shrink-0 pt-0.5">
                  {item.price}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

      <!-- Menu Disclaimer / Policy Note -->
      <div class="p-6 rounded-2xl bg-[var(--color-ink)]/5 border border-[var(--color-ink)]/10 text-xs text-[var(--color-ink)]/80 text-center space-y-2">
        <p><strong>Dining Notice:</strong> {menu.disclaimer}</p>
        <p class="text-[11px] text-[var(--color-ink)]/60">
          Cast-Iron KBBQ tables are limited to 5 groups daily to maintain bespoke table-side grilling and meat freshness.
        </p>
      </div>

      <!-- Bottom Reservation Call-to-Action Banner -->
      <div class="text-center pt-8">
        <a
          href="/demo/gamja/reservations"
          class="btn-pill-cream text-xs uppercase tracking-widest px-10 py-4 font-semibold shadow-md inline-block"
        >
          Book Your Table via WhatsApp
        </a>
      </div>
    </div>
  </section>
</RestaurantDemoLayout>
