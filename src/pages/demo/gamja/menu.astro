---
import RestaurantDemoLayout from "../../../layouts/RestaurantDemoLayout.astro";
import QitchenNavbar from "../../../components/restaurant/qitchen/QitchenNavbar.astro";
import CornerFrame from "../../../components/restaurant/qitchen/CornerFrame.astro";
import QitchenFooter from "../../../components/restaurant/qitchen/QitchenFooter.astro";
import data from "../../../data/restaurants/gamja.json";

const { restaurant, menu } = data;
---

<RestaurantDemoLayout
  restaurantData={data}
  title={`Menu & Courses | ${restaurant.name} Singapore`}
  description={`Explore ${restaurant.name}'s authentic Korean comfort menu at 21 Boon Tat Street. Slow-simmered pork bone Gamjatang bowls from ${menu.basePrice}, cast-iron KBBQ, and sharing hotpots.`}
  currentPath="/demo/gamja/menu"
  hideHeader={true}
  hideFooter={true}
>
  <div class="min-h-screen bg-[#0A0B0A] text-[#F5EFEB] flex flex-col justify-between">
    
    <!-- Top Floating Navbar Container -->
    <div class="p-4 sm:p-6 max-w-7xl mx-auto w-full flex items-center justify-between">
      <QitchenNavbar currentPath="/demo/gamja/menu" bookUrl="/demo/gamja/reservations" />
      <div class="hidden sm:block text-xs uppercase tracking-[0.25em] text-[#DAC5A7]/70 font-mono">
        DAILY LUNCH & DINNER
      </div>
    </div>

    <!-- Page Header in Qitchen Nocturnal Luxury Style -->
    <section class="relative w-full text-[#F5EFEB] pt-8 pb-12 sm:pt-14 sm:pb-16 px-4 sm:px-6 lg:px-8 overflow-hidden">
      <!-- Ambient Glow -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-[radial-gradient(ellipse_at_center,rgba(218,197,167,0.08),transparent_70%)] pointer-events-none blur-3xl"></div>

      <div class="max-w-4xl mx-auto text-center relative z-10">
        <div class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.28em] text-[#DAC5A7] font-medium mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C23B22]"></span>
          <span>AUTHENTIC MENU • 21 BOON TAT STREET</span>
        </div>
        
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-normal text-white tracking-tight leading-tight mb-4">
          {menu.title}
        </h1>
        
        <p class="text-sm sm:text-base text-[#F5EFEB]/70 font-light leading-relaxed max-w-2xl mx-auto mb-8">
          {menu.description}
        </p>

        <!-- Category Tabs Bar (Signature Qitchen Component) -->
        <div class="flex flex-wrap items-center justify-center gap-2 max-w-3xl mx-auto">
          {menu.categories.map((cat, idx) => (
            <a
              href={`#section-${idx + 1}`}
              class="px-4 py-2 rounded-full bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 hover:border-[#DAC5A7] text-[11px] sm:text-xs uppercase tracking-wider text-[#DAC5A7] transition-all duration-200"
            >
              {cat.name.split(" (")[0]}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Menu Categories in Framed Architectural Bento Style -->
    <section class="w-full text-[#F5EFEB] pb-16 sm:pb-24 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto space-y-12 sm:space-y-16">
        
        {menu.categories.map((cat, idx) => (
          <div id={`section-${idx + 1}`} class="scroll-mt-24">
            <CornerFrame class="bg-[#141312] p-6 sm:p-10 lg:p-12 hover:border-[#DAC5A7]/30 transition-colors">
              
              <!-- Category Header -->
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-6 mb-8 border-b border-white/10">
                <div>
                  <span class="text-[10px] uppercase tracking-[0.25em] text-[#DAC5A7] font-semibold block mb-1">
                    SECTION 0{idx + 1}
                  </span>
                  <h2 class="font-display text-2xl sm:text-3xl font-normal text-white">
                    {cat.name}
                  </h2>
                  {cat.description && (
                    <p class="text-xs text-[#F5EFEB]/60 font-light leading-relaxed mt-1 max-w-2xl">
                      {cat.description}
                    </p>
                  )}
                </div>
              </div>

              <!-- Items List with Dotted Leaders -->
              <div class="space-y-6 sm:space-y-8">
                {cat.items.map((item) => (
                  <div class="group">
                    <div class="flex items-baseline justify-between w-full gap-2 sm:gap-4">
                      <div class="flex items-baseline gap-2 flex-wrap">
                        <h3 class="font-display text-lg sm:text-xl font-normal text-white group-hover:text-[#DAC5A7] transition-colors">
                          {item.name}
                        </h3>
                      </div>
                      <span class="flex-grow border-b border-dotted border-white/20 mx-2 mb-1 hidden sm:inline-block"></span>
                      <span class="font-mono text-sm sm:text-base text-[#DAC5A7] font-semibold whitespace-nowrap">
                        {item.price}
                      </span>
                    </div>

                    <p class="text-xs sm:text-sm text-[#F5EFEB]/65 font-light leading-relaxed mt-1 max-w-3xl">
                      {item.description}
                    </p>

                    {item.dietary && item.dietary.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 mt-2.5">
                        {item.dietary.map((d: string) => (
                          <span class={`px-2 py-0.5 rounded-full text-[9px] uppercase tracking-wider font-medium ${
                            d === "Signature" || d === "Must Try" || d === "Viral Sensation"
                              ? "bg-[#C23B22]/20 border border-[#C23B22]/40 text-[#DAC5A7]"
                              : d === "5 Tables Daily" || d === "Limited"
                              ? "bg-amber-500/10 border border-amber-500/30 text-amber-200"
                              : "bg-white/[0.03] border border-white/10 text-[#F5EFEB]/60"
                          }`}>
                            {d}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>

            </CornerFrame>
          </div>
        ))}

        <!-- Dining Notice & Policies Box -->
        <div class="p-6 sm:p-8 rounded-xl bg-white/[0.02] border border-white/10 text-xs text-[#F5EFEB]/70 text-center max-w-3xl mx-auto space-y-2">
          <p><strong class="text-white">Dining Notice:</strong> {menu.disclaimer}</p>
          <p class="text-[11px] text-[#DAC5A7]/80">
            Cast-Iron K-BBQ tables are limited to 5 groups daily to ensure bespoke table-side grilling and absolute meat freshness.
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-6">
          <a
            href="/demo/gamja/reservations"
            class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-[#DAC5A7] hover:bg-white text-[#0A0B0A] text-xs uppercase tracking-widest font-semibold transition-all duration-200 shadow-lg group"
          >
            <span>Book a Table Online</span>
            <span class="transform group-hover:translate-x-1 transition-transform">→</span>
          </a>
          <a
            href={`https://wa.me/${restaurant.whatsapp.replace(/[^0-9]/g, '')}?text=Hi%20GAMJA%2C%20I%20have%20a%20question%20about%20the%20menu`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-7 py-4 rounded-full bg-white/[0.04] hover:bg-white/[0.08] border border-white/15 text-[#F5EFEB] text-xs uppercase tracking-widest font-medium transition-colors"
          >
            <span>Ask on WhatsApp</span>
          </a>
        </div>

      </div>
    </section>

    <!-- Architectural Footer -->
    <QitchenFooter
      restaurantName={restaurant.name}
      address={`${restaurant.address}, ${restaurant.city} ${restaurant.postalCode}`}
      phone={restaurant.phone}
      instagram={restaurant.social.instagram}
    />
  </div>
</RestaurantDemoLayout>
