---
import RestaurantDemoLayout from "../../../layouts/RestaurantDemoLayout.astro";
import ReservationForm from "../../../components/restaurant/ReservationForm.astro";
import data from "../../../data/restaurants/gamja.json";

const { restaurant, reservations } = data;
---

<RestaurantDemoLayout
  restaurantData={data}
  title={`Table & BBQ Reservations | ${restaurant.name} Telok Ayer`}
  description={`Request a dining table or K-BBQ seating at ${restaurant.name} (21 Boon Tat Street, Singapore). Book instantly online or connect directly via WhatsApp.`}
  currentPath="/demo/gamja/reservations"
>
  <!-- Subpage Header -->
  <section class="w-full text-[var(--color-on-primary)] pt-28 pb-12 sm:pt-36 sm:pb-16 px-4 sm:px-6 text-center border-b border-[var(--color-on-primary)]/10" style="background-color: color-mix(in srgb, var(--color-primary) 90%, black);">
    <div class="max-w-2xl mx-auto">
      <span class="text-xs uppercase tracking-[0.3em] text-[var(--color-accent)] font-semibold mb-3 block">
        Direct Table & BBQ Bookings
      </span>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-light tracking-tight mb-4 text-[var(--color-on-primary)]">
        {reservations.title}
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-on-primary)]/85 font-light leading-relaxed">
        {reservations.subtitle}. Request your preferred lunch or dinner seating directly with the founding team.
      </p>
    </div>
  </section>

  <!-- Reservation Form Area (Surface Background) -->
  <section class="w-full bg-[var(--color-surface)] py-16 sm:py-24 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Instant Online Booking Option (MyNeon) -->
      <div class="max-w-xl mx-auto mb-8 p-5 rounded-2xl bg-white border border-[var(--color-primary)]/20 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <div>
          <span class="text-[10px] uppercase tracking-[0.25em] text-[var(--color-primary)] font-bold block mb-1">
            Instant Confirmation
          </span>
          <p class="text-sm font-medium text-[var(--color-ink)]">
            Prefer immediate online table confirmation?
          </p>
          <p class="text-xs text-[var(--color-ink)]/70">
            Book live via GAMJA's official Neon Table booking system.
          </p>
        </div>
        <a
          href="https://myneon.me/?m=booking&sno=1500"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center font-medium rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] text-xs uppercase tracking-widest px-6 py-3 shadow hover:shadow-md transition-all duration-200 flex-shrink-0"
        >
          Book on MyNeon →
        </a>
      </div>

      <!-- Astro Form Component -->
      <ReservationForm
        whatsappNumber={restaurant.whatsapp}
        restaurantName={restaurant.name}
        recipientName="Shin Jae-Yoon & Chef Nam Wan-Hyuk"
        seatingTimes={reservations.seatingTimes}
        capacityText={reservations.capacityText}
        closedDaysNotice={reservations.closedDaysNotice}
        maxPartySize={12}
        eyebrow="Dining Room & K-BBQ Request"
      />

      <!-- Policies & Dining Information Grid -->
      <div class="mt-16 max-w-xl mx-auto pt-10 border-t border-[var(--color-ink)]/15 text-[var(--color-ink)] space-y-6">
        <h2 class="text-xs uppercase tracking-[0.25em] text-[var(--color-ink)]/60 font-semibold text-center mb-6">
          Seating & Reservation Guidelines
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs leading-relaxed">
          <div class="space-y-2 p-4 rounded-xl bg-white border border-[var(--color-ink)]/10 shadow-sm">
            <span class="font-semibold block text-sm text-[var(--color-primary)]">Table Holding Policy</span>
            <p class="text-[var(--color-ink)]/75">
              Tables are held for 10 minutes (lunch) and 15 minutes (dinner) past your reserved time before being released to walk-in diners.
            </p>
          </div>

          <div class="space-y-2 p-4 rounded-xl bg-white border border-[var(--color-ink)]/10 shadow-sm">
            <span class="font-semibold block text-sm text-[var(--color-primary)]">5 K-BBQ Tables Daily</span>
            <p class="text-[var(--color-ink)]/75">
              To keep meat preparation and table-side grilling at their finest, our Cast-Iron K-BBQ is strictly limited to only 5 tables per day.
            </p>
          </div>

          <div class="space-y-2 p-4 rounded-xl bg-white border border-[var(--color-ink)]/10 shadow-sm">
            <span class="font-semibold block text-sm text-[var(--color-primary)]">Dining Duration & Changes</span>
            <p class="text-[var(--color-ink)]/75">
              Dining time is up to 120 minutes during peak hours. Please kindly modify or cancel your reservation at least 2 hours prior.
            </p>
          </div>

          <div class="space-y-2 p-4 rounded-xl bg-white border border-[var(--color-ink)]/10 shadow-sm">
            <span class="font-semibold block text-sm text-[var(--color-primary)]">Group Bookings (> 8 Pax)</span>
            <p class="text-[var(--color-ink)]/75">
              For gatherings of more than 8 guests, please connect with our team directly via WhatsApp or call +65 6222 1206.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</RestaurantDemoLayout>
