---
import RestaurantDemoLayout from "../../../layouts/RestaurantDemoLayout.astro";
import HeroWave from "../../../components/restaurant/HeroWave.astro";
import IntroSection from "../../../components/restaurant/IntroSection.astro";
import FiveTileStrip from "../../../components/restaurant/FiveTileStrip.astro";
import FeatureSplit from "../../../components/restaurant/FeatureSplit.astro";
import PhotoCarousel from "../../../components/restaurant/PhotoCarousel.astro";
import LocationBlock from "../../../components/restaurant/LocationBlock.astro";
import ClosingCta from "../../../components/restaurant/ClosingCta.astro";

import data from "../../../data/restaurants/saikyo-pasta.json";

const { restaurant, hero, sections, story } = data;
---

<RestaurantDemoLayout
  restaurantData={data}
  title={`${restaurant.name} | ${restaurant.tagline}`}
  description={hero.subline}
  currentPath="/demo/saikyo-pasta"
>
  <!-- 1. Hero with Organic Wave Transition -->
  <HeroWave
    headline={hero.headline}
    subline={hero.subline}
    image={hero.image}
    ctaLabel={hero.ctaLabel}
    ctaHref="/demo/saikyo-pasta/reservations"
    imageAlt="Saikyo Pasta signature dishes on wooden counter"
  />

  <!-- 2. Intro Section -->
  <IntroSection
    heading={sections.intro.heading}
    paragraphs={sections.intro.paragraphs}
    eyebrow="The Saikyo Story"
  />

  <!-- 3. Four-Tile Image Strip -->
  <FiveTileStrip tiles={sections.fiveTiles} />

  <!-- 4. Feature Split Block -->
  <FeatureSplit
    heading={sections.feature.heading}
    paragraph={sections.feature.paragraph}
    ctaLabel={sections.feature.ctaLabel}
    ctaHref={sections.feature.ctaHref}
    image={sections.feature.image}
    tag={sections.feature.tag}
    imageAlt="Homemade secret mentaiko sauce craft"
  />

  <!-- 5. Founders Story & Philosophy Section (Refined Warm Light Sand) -->
  <section id="story" class="w-full bg-[#F5F1EB] text-[var(--color-ink)] py-20 sm:py-28 px-4 sm:px-6 border-t border-[var(--color-ink)]/10">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
      <div class="md:col-span-5 h-[460px] sm:h-[520px] rounded-2xl overflow-hidden shadow-xl relative">
        <img
          src={story.image}
          alt="Founders and Chef at Saikyo Pasta"
          class="w-full h-full object-cover object-center filter brightness-[0.98]"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-6 text-white">
          <span class="text-xs uppercase tracking-widest text-white/70 font-semibold block">{story.chefRole}</span>
          <p class="font-display text-2xl font-light text-white">{story.chefName}</p>
        </div>
      </div>

      <div class="md:col-span-7 flex flex-col items-start">
        <span class="text-xs uppercase tracking-[0.3em] text-[var(--color-accent)] font-semibold mb-3">
          {story.tag}
        </span>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-light leading-[1.2] mb-6 text-[var(--color-ink)]">
          {story.title}
        </h2>
        <div class="space-y-4 text-base sm:text-lg text-[var(--color-ink)]/80 font-light leading-relaxed mb-8">
          {story.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
        <div class="p-4 rounded-xl border border-[var(--color-ink)]/10 bg-white text-xs sm:text-sm text-[var(--color-accent)] font-medium mb-6 shadow-sm">
          "{story.quote}"
        </div>
        <a
          href="/demo/saikyo-pasta/menu"
          class="btn-pill-burgundy text-xs uppercase tracking-widest px-8 py-3.5 font-medium"
        >
          Explore Our Wafu Menu
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Photo Carousel (4 Signature Dishes) -->
  <PhotoCarousel
    items={sections.carousel}
    title="Signature Wafu Pastas"
    subtitle="Simmered Fresh Upon Order"
    tagPrefix="Dish"
  />

  <!-- 7. Location & Transit Block -->
  <LocationBlock
    heading="Join Us at Icon Village"
    subline="12 Gopeng Street #01-86/87, 2 minutes from Tanjong Pagar MRT Exit A."
    address={restaurant.address}
    postalCode={restaurant.postalCode}
    mrt={restaurant.mrt}
    hoursText="Mon - Sat: Lunch 11:30 AM - 2:00 PM, Dinner 6:00 PM - 8:00 PM"
    hoursSubtext="Closed on Sundays • 12 counter seats"
    phone={restaurant.phone}
    googleMapsUrl={restaurant.googleMapsUrl}
    mapTitle="Saikyo Pasta Icon Village Location Map"
  />

  <!-- 8. Closing CTA -->
  <ClosingCta
    heading="Your Counter Seat Awaits"
    subline="Experience Japanese-Italian wafu comfort, cooked fresh upon order in Tanjong Pagar."
    ctaLabel="Reserve a Table via WhatsApp"
    ctaHref="/demo/saikyo-pasta/reservations"
  />
</RestaurantDemoLayout>
