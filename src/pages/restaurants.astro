---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Websites for Independent Singapore Restaurants | Evonera Technologies"
  description="Bespoke, high-converting websites for independent restaurants, izakayas, and omakase counters in Singapore. Built by Evonera Technologies."
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-20 sm:py-28 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-mono uppercase tracking-wider mb-6">
      Evonera Hospitality Studio
    </div>

    <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-white mb-6 max-w-3xl mx-auto leading-tight">
      Bespoke Websites for Singapore's Best Restaurants
    </h1>

    <p class="text-lg sm:text-xl text-neutral-400 max-w-2xl mx-auto leading-relaxed mb-10">
      We build editorial, mobile-first websites for independent dining rooms, omakase counters, and bistros, eliminating third-party booking commissions and showcasing your culinary craft.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/contact"
        class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition-all shadow-lg shadow-blue-500/20"
      >
        Request a No-Obligation Demo
      </a>
      <a
        href="/services"
        class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-neutral-900 hover:bg-neutral-800 text-neutral-300 border border-white/10 font-medium text-sm transition-all"
      >
        Our Engineering Services
      </a>
    </div>
  </section>

  <!-- Key Benefits Grid -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-24">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="p-8 rounded-2xl bg-neutral-900/60 border border-white/10">
        <div class="w-10 h-10 rounded-xl bg-blue-500/15 border border-blue-500/30 flex items-center justify-center text-blue-400 font-bold mb-5">
          01
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Editorial, Photo-Led Aesthetic</h3>
        <p class="text-sm text-neutral-400 leading-relaxed">
          Inspired by Singapore's most celebrated dining rooms. Custom typography, organic curves, and seamless photography that captures your dining atmosphere.
        </p>
      </div>

      <div class="p-8 rounded-2xl bg-neutral-900/60 border border-white/10">
        <div class="w-10 h-10 rounded-xl bg-blue-500/15 border border-blue-500/30 flex items-center justify-center text-blue-400 font-bold mb-5">
          02
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Direct WhatsApp Reservations</h3>
        <p class="text-sm text-neutral-400 leading-relaxed">
          Guests request tables through a streamlined form that routes straight to your phone or WhatsApp, cutting out expensive per-cover reservation platform fees.
        </p>
      </div>

      <div class="p-8 rounded-2xl bg-neutral-900/60 border border-white/10">
        <div class="w-10 h-10 rounded-xl bg-blue-500/15 border border-blue-500/30 flex items-center justify-center text-blue-400 font-bold mb-5">
          03
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Blazing Fast on Mobile</h3>
        <p class="text-sm text-neutral-400 leading-relaxed">
          Over 80% of diners browse menus on mobile phones. Built with Astro for sub-second load speeds, instant menu access, and 98+ Lighthouse scores.
        </p>
      </div>
    </div>
  </section>

  <!-- Outreach CTA -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 pb-28 text-center">
    <div class="p-10 rounded-3xl bg-gradient-to-b from-neutral-900 to-neutral-950 border border-white/10">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
        Want to see how your restaurant looks?
      </h2>
      <p class="text-sm text-neutral-400 max-w-lg mx-auto mb-8 leading-relaxed">
        Send us your Instagram handle or menu, and we will build a free, no-obligation concept demo within 48 hours.
      </p>
      <a
        href="https://wa.me/919361664440"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-sm transition-all shadow-lg"
      >
        <span>Message Us on WhatsApp</span>
      </a>
    </div>
  </section>
</Layout>
