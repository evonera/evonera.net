---
import Layout from "../layouts/Layout.astro";
import { ProjectBriefForm } from "../components/ProjectBriefForm";
---

<Layout title="Software Engineering & Web Development Services — Evonera Technologies" description="Full-stack web applications, backend integrations, and AI prototype rescues. Fixed scope and price agreed before work begins.">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 sm:pt-24 pb-16">
    <p class="text-sm font-medium text-blue-300">Engineering Capabilities</p>
    <h1 class="mt-4 max-w-3xl text-4xl sm:text-5xl font-semibold text-neutral-50 tracking-tight">Software engineering built to ship.</h1>
    <p class="mt-5 max-w-2xl text-base text-neutral-300 leading-relaxed">We help founders and businesses build reliable web applications from scratch, and take unfinished AI prototypes across the finish line into production.</p>
  </section>
  <section class="border-y border-white/10 bg-ink-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 grid grid-cols-1 md:grid-cols-2 gap-px border-x border-white/10 bg-ink-800">
      <article class="bg-ink-900 p-6 sm:p-8">
        <h2 class="text-xl font-semibold text-neutral-100">Full-Stack Web Applications</h2>
        <p class="mt-3 text-sm leading-relaxed text-neutral-300">Custom web apps and internal tools built with React, Astro, Next.js, and TypeScript, engineered for speed and maintainability.</p>
      </article>
      <article class="bg-ink-900 p-6 sm:p-8">
        <h2 class="text-xl font-semibold text-neutral-100">AI Prototype Rescue & Refactoring</h2>
        <p class="mt-3 text-sm leading-relaxed text-neutral-300">Untangle stuck code from Lovable, Emergent, Bolt, or v0 into production-grade systems ready for paying users.</p>
      </article>
      <article class="bg-ink-900 p-6 sm:p-8">
        <h2 class="text-xl font-semibold text-neutral-100">Backends, Databases & Payments</h2>
        <p class="mt-3 text-sm leading-relaxed text-neutral-300">Robust data architecture, Supabase, PostgreSQL, Stripe checkout, authentication, and secure third-party API webhooks.</p>
      </article>
      <article class="bg-ink-900 p-6 sm:p-8">
        <h2 class="text-xl font-semibold text-neutral-100">Performance, Deployment & Handover</h2>
        <p class="mt-3 text-sm leading-relaxed text-neutral-300">Edge deployment on Cloudflare or Vercel, sub-second load times, clean documentation, and 100% code ownership.</p>
      </article>
    </div>
  </section>
  <section id="project-review" class="border-t border-white/10 bg-ink-950 px-4 sm:px-6 py-16 sm:py-20">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mx-auto text-center mb-8">
        <p class="text-sm font-medium text-blue-300">Start with your project</p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-semibold text-neutral-50">Tell us what you want to build.</h2>
        <p class="mt-3 text-sm text-neutral-300 leading-relaxed">Share your requirements or existing codebase and we will reply within 24 hours.</p>
      </div>
      <ProjectBriefForm client:load />
    </div>
  </section>
</Layout>
