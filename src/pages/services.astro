---
import Layout from "../layouts/Layout.astro";
import { ProjectBriefForm } from "../components/ProjectBriefForm";
---

<Layout title="AI App Rescue Services — Evonera Technologies" description="Focused engineering help to finish, fix, and launch apps started with AI builders.">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 sm:pt-24 pb-16">
    <p class="text-sm font-medium text-blue-300">What we help with</p>
    <h1 class="mt-4 max-w-3xl text-4xl sm:text-5xl font-semibold text-neutral-50 tracking-tight">Finish the app you already started.</h1>
    <p class="mt-5 max-w-2xl text-base text-neutral-300 leading-relaxed">We work on existing projects from Lovable, Emergent, and other AI builders. We first review your app and goals, then agree on the right scope before any paid work begins.</p>
  </section>
  <section class="border-y border-white/10 bg-ink-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 grid grid-cols-1 md:grid-cols-2 gap-px border-x border-white/10 bg-ink-800">
      <article class="bg-ink-900 p-6 sm:p-8"><h2 class="text-xl font-semibold text-neutral-100">Complete unfinished features</h2><p class="mt-3 text-sm leading-relaxed text-neutral-300">Move important user flows from placeholder screens to working functionality.</p></article>
      <article class="bg-ink-900 p-6 sm:p-8"><h2 class="text-xl font-semibold text-neutral-100">Fix bugs and broken behavior</h2><p class="mt-3 text-sm leading-relaxed text-neutral-300">Understand the current code and resolve the issues blocking progress.</p></article>
      <article class="bg-ink-900 p-6 sm:p-8"><h2 class="text-xl font-semibold text-neutral-100">Connect data and services</h2><p class="mt-3 text-sm leading-relaxed text-neutral-300">Add or repair the backend, authentication, APIs, or payment flows your project needs.</p></article>
      <article class="bg-ink-900 p-6 sm:p-8"><h2 class="text-xl font-semibold text-neutral-100">Deploy and hand over</h2><p class="mt-3 text-sm leading-relaxed text-neutral-300">Prepare deployment and explain how to operate and continue developing the project.</p></article>
    </div>
  </section>
  <section id="project-review" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20"><ProjectBriefForm client:load /></section>
</Layout>
