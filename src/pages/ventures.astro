---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Our SaaS Products — Evonera Technologies" description="Explore the software products built and operated by Evonera Technologies Pvt Ltd.">
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-16 pb-20">
    <div class="max-w-2xl mx-auto text-center mb-16">
      <span class="text-xs font-mono uppercase tracking-widest text-yellow-300">Proprietary Software</span>
      <h1 class="text-4xl sm:text-5xl font-medium text-neutral-100 mt-2">
        Products we own and operate.
      </h1>
      <p class="mt-4 text-base text-neutral-400">
        We build and operate products of our own alongside our work helping founders finish AI-built apps.
      </p>
    </div>

    <div class="space-y-8">
      <!-- Product 1: Booky -->
      <div class="rounded-xl border border-white/15 bg-ink-900 p-8 sm:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8 hover:border-blue-500/50 transition-colors">
        <div class="space-y-3 max-w-xl">
          <div class="flex items-center gap-3">
            <div class="size-10 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-base">
              B
            </div>
            <div>
              <h2 class="text-2xl font-medium text-neutral-100">Booky for macOS</h2>
              <span class="text-xs font-mono text-faint">On-Device AI Audiobook Reader</span>
            </div>
          </div>

          <p class="text-sm text-neutral-300 leading-relaxed pt-2">
            A native macOS app that transforms any DRM-free EPUB into a studio-quality neural audiobook using Kokoro-82M CoreML on Apple Silicon. Features 100% offline playback, synchronized read-along highlighting, M4A export, and zero cloud subscriptions.
          </p>

          <div class="flex flex-wrap items-center gap-2 pt-2 text-xs font-mono text-faint">
            <span class="bg-ink-800 px-2.5 py-1 rounded border border-white/10">Swift 6</span>
            <span class="bg-ink-800 px-2.5 py-1 rounded border border-white/10">CoreML 24kHz</span>
            <span class="bg-ink-800 px-2.5 py-1 rounded border border-white/10">Readium 3.9</span>
            <span class="bg-ink-800 px-2.5 py-1 rounded border border-white/10">Mac App Store</span>
          </div>
        </div>

        <div class="shrink-0 flex flex-col gap-3 w-full md:w-auto">
          <a
            href="https://bookyapp.com"
            class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-xs text-center shadow transition-transform active:scale-95"
          >
            Visit Booky Website ↗
          </a>
        </div>
      </div>

      <!-- Product 2: Prop&Roll -->
      <div class="rounded-xl border border-white/15 bg-ink-900 p-8 sm:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8 hover:border-blue-500/50 transition-colors">
        <div class="space-y-3 max-w-xl">
          <div class="flex items-center gap-3">
            <div class="size-10 rounded-lg bg-blue-500 flex items-center justify-center text-white font-bold text-base">
              P
            </div>
            <div>
              <h2 class="text-2xl font-medium text-neutral-100">Prop&Roll</h2>
              <span class="text-xs font-mono text-faint">AI-Powered NBA Prop Analysis Platform</span>
            </div>
          </div>

          <p class="text-sm text-neutral-300 leading-relaxed pt-2">
            Advanced basketball analytics platform providing real-time AI prop grades (A–F), live sportsbook odds tracking across DraftKings, FanDuel, and BetMGM, 50+ statistical factors, historical hit rates, and PropAI interactive chat.
          </p>

          <div class="flex flex-wrap items-center gap-2 pt-2 text-xs font-mono text-faint">
            <span class="bg-ink-800 px-2.5 py-1 rounded border border-white/10">AI Sports Analytics</span>
            <span class="bg-ink-800 px-2.5 py-1 rounded border border-white/10">Real-Time Odds API</span>
            <span class="bg-ink-800 px-2.5 py-1 rounded border border-white/10">PropAI Chat</span>
          </div>
        </div>

        <div class="shrink-0 flex flex-col gap-3 w-full md:w-auto">
          <a
            href="https://www.propandrollapp.com"
            target="_blank"
            rel="noreferrer"
            class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-xs text-center shadow transition-transform active:scale-95"
          >
            Visit Prop&Roll ↗
          </a>
        </div>
      </div>

      <!-- Product 3: VodClip -->
      <div class="rounded-xl border border-white/15 bg-ink-900 p-8 sm:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8 hover:border-purple-500/50 transition-colors">
        <div class="space-y-3 max-w-xl">
          <div class="flex items-center gap-3">
            <div class="size-10 rounded-lg bg-purple-600 flex items-center justify-center text-white font-bold text-base">
              V
            </div>
            <div>
              <h2 class="text-2xl font-medium text-neutral-100">VodClip</h2>
              <span class="text-xs font-mono text-faint">AI Video Stream Clipping Tool</span>
            </div>
          </div>

          <p class="text-sm text-neutral-300 leading-relaxed pt-2">
            AI-powered video clipping platform that turns long Twitch, YouTube, and Kick streams into viral vertical TikToks, YouTube Shorts, and Instagram Reels. Uses WebCodecs for browser-based processing, automatic face-tracking, chat spike detection, and viral scoring.
          </p>

          <div class="flex flex-wrap items-center gap-2 pt-2 text-xs font-mono text-faint">
            <span class="bg-ink-800 px-2.5 py-1 rounded border border-white/10">WebCodecs Video Engine</span>
            <span class="bg-ink-800 px-2.5 py-1 rounded border border-white/10">AI Face Tracking</span>
            <span class="bg-ink-800 px-2.5 py-1 rounded border border-white/10">Auto-Subtitles</span>
          </div>
        </div>

        <div class="shrink-0 flex flex-col gap-3 w-full md:w-auto">
          <a
            href="https://www.vodclip.com"
            target="_blank"
            rel="noreferrer"
            class="px-5 py-2.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-medium text-xs text-center shadow transition-transform active:scale-95"
          >
            Visit VodClip ↗
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom CTA -->
    <div class="mt-16 text-center border-t border-white/10 pt-12">
          <h3 class="text-xl font-medium text-neutral-100">Need help finishing your own app?</h3>
      <p class="mt-2 text-xs text-neutral-400 max-w-md mx-auto">
        Tell us what is unfinished and we’ll review the project before proposing the next step.
      </p>
      <div class="mt-6">
        <a
          href="/fix-my-ai-site#project-review"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-xs shadow transition-transform active:scale-95"
        >
          Get help with your app
        </a>
      </div>
    </div>
  </section>
</Layout>
